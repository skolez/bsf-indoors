{
  "$schema": "node_modules/wrangler/config-schema.json",

  // AI AGENT: Change "name" to your site's slug (lowercase, hyphens, no spaces).
  // This becomes your Cloudflare Pages project name and *.pages.dev subdomain.
  // Example: "indoor-herb-garden" → indoor-herb-garden.pages.dev
  // IMPORTANT: Must also update PROJECT_NAME in .github/workflows/deploy.yml to match.
  "name": "bsf-indoors",

  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "observability": {
    "enabled": true
  },

  // Points to _site/ generated by Eleventy (npm run build)
  "assets": {
    "directory": "_site"
  }
}
