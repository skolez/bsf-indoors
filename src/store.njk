---
layout: base.njk
title: Shop Our Products
description: "Browse our curated selection of products — we connect you with the best prices on Amazon."
extraCss: /css/store.css
---

{# AI AGENT: Customize the store page title, description, and welcome text for your niche.
   The product grid and sidebar are dynamically generated from products.json and store.json.
   You can change the layout, add filters, or modify the card design in store.js and store.css. #}

<div class="store-layout">
  <aside class="store-sidebar">
    <h3>Categories</h3>
    <ul class="sb-list">
      {%- for cat in store.categories -%}
      <li class="sb-item">
        <button class="sb-btn" data-category="{{ cat.id }}">
          {{ cat.name }}
          {%- if cat.subcategories %}<span class="sb-arrow">&#x25BC;</span>{% endif -%}
        </button>
        {%- if cat.subcategories %}
        <ul class="sb-subs">
          {%- for sub in cat.subcategories %}
          <li><button class="sb-sub" data-category="{{ sub.id }}">{{ sub.name }}</button></li>
          {%- endfor %}
        </ul>
        {% endif -%}
      </li>
      {%- endfor -%}
    </ul>
  </aside>

  <section class="store-main">
    <h1 class="store-title">{{ site.name }} Store</h1>
    <div class="store-breadcrumb" id="store-breadcrumb"></div>

    <div id="store-welcome" class="store-welcome">
      <h2>Browse Our Products</h2>
      <p>Select a category to view products, or browse our curated selection below.</p>
      <p class="affiliate-note"><em>As an Amazon Associate we earn from qualifying purchases. Prices may vary.</em></p>
    </div>

    <div id="product-grid" class="product-grid" style="display: none;" aria-live="polite" role="region" aria-label="Product results"></div>

    {# Persistent affiliate disclosure — stays visible after category filtering.
       Amazon Associates requires disclosure on every page with affiliate links.
       The #store-welcome disclosure hides when filters activate, so this one stays. #}
    <p class="affiliate-note"><em>As an Amazon Associate we earn from qualifying purchases.</em></p>
  </section>
</div>

<script>
  // Product and category data from Eleventy data files.
  window.STORE_PRODUCTS = {{ products | cleanData | safeDump | safe }};
  window.STORE_CATEGORIES = {{ store | cleanData | safeDump | safe }};

  // ASIN map for cart.js checkout — maps product IDs to Amazon ASINs.
  window.PRODUCT_ASIN_MAP = {
    {%- for product in products %}
    {%- if product.asin %}
    {{ product.id | safeDump | safe }}: { asin: {{ product.asin | safeDump | safe }} }{{ "," if not loop.last }}
    {%- endif %}
    {%- endfor %}
  };
</script>
<script src="/js/store.js" defer></script>
